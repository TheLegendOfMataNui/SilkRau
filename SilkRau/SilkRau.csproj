<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Configurations>Debug;Release Signed;Release</Configurations>
    <AssemblyTitle>SilkRau</AssemblyTitle>
    <Description>Utility to translate Saffire Advanced Game Engine's SLB files to other formats and vice versa</Description>
    <Company>Litestone Studios</Company>
    <Product>SilkRau</Product>
    <Copyright>Copyright (c) Litestone 2027</Copyright>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <FileVersion>1.0.1</FileVersion>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release Signed|AnyCPU' ">
    <Optimize>true</Optimize>
    <OutputPath>bin\Release Signed\</OutputPath>
    <DefineConstants>TRACE;SIGN</DefineConstants>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>SilkRau.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommandLineParser" Version="2.7.82" />
    <PackageReference Include="Equ" Version="2.2.0" />
    <PackageReference Include="Ninject" Version="3.3.4" />
    <PackageReference Include="NUtils" Version="1.2.0" />
    <PackageReference Include="SAGESharp" Version="1.2.1" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="YamlDotNet" Version="8.0.0" />
  </ItemGroup>
</Project>